<UserControl x:Class="Campfire.Pages.RepairPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Campfire.Localization">

    <UserControl.Resources>
        <Style x:Key="RepairCheckBox" TargetType="CheckBox">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="20" Height="20">
                            <Border x:Name="Box" CornerRadius="4" BorderThickness="1.5"
                                    Background="{DynamicResource BrushInput}"
                                    BorderBrush="{DynamicResource BrushGray5}" />
                            <Path x:Name="CheckMark" Width="14" Height="14" Stretch="None"
                                  Data="M3.5,8 L6.3,10.8 L12.5,4.5"
                                  Stroke="{DynamicResource BrushOnAccent}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush3}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush3}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush3}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="PatchRowTemplate">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Margin="0,0,12,0" Style="{StaticResource RepairCheckBox}"
                          VerticalAlignment="Center"
                          IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{Binding IsSelectable}" ToolTip="{loc:Text Main.SelectRepair}" />
                <Border Grid.Column="1" Width="22" Height="22" Margin="0,0,12,0" CornerRadius="11"
                        VerticalAlignment="Center" BorderThickness="1.5" BorderBrush="{Binding Accent}">
                    <Path Width="16" Height="16" Stretch="None" Data="{Binding Icon}"
                          Stroke="{Binding Accent}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" />
                    <TextBlock Margin="0,1,0,0" FontSize="12" Foreground="{DynamicResource BrushGray4}"
                               Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                           Foreground="{Binding Accent}" Text="{Binding StateText}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Margin="22,20,22,18">

        <HeaderedContentControl Header="{loc:Text Main.Launcher}" Style="{StaticResource PclCard}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="LabFileName" FontSize="14" Text="{loc:Text Main.NoLauncher}" />
                            <Border x:Name="PanVersion" Margin="8,0,0,0" Padding="6,0" CornerRadius="3"
                                    VerticalAlignment="Center" Background="{DynamicResource Brush7}"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="LabVersion" FontSize="12" Foreground="{DynamicResource Brush3}" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="LabFilePath" Margin="0,3,0,0" FontSize="12"
                                   Foreground="{DynamicResource BrushGray4}" TextTrimming="CharacterEllipsis"
                                   Text="{loc:Text Main.PickHint}" />
                    </StackPanel>
                    <Button x:Name="BtnBrowse" Grid.Column="1" Margin="16,0,0,0" Content="{loc:Text Main.Browse}"
                            Style="{StaticResource PclButton}" Click="BtnBrowse_Click" />
                </Grid>

                <ContentControl x:Name="HintStatus" Margin="0,14,0,0" Style="{StaticResource PclHint}">
                    <TextBlock x:Name="LabStatus" TextWrapping="Wrap" Text="{loc:Text Status.Searching}" />
                </ContentControl>

                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <Button x:Name="BtnOpenFolder" Content="{loc:Text Main.OpenFolder}" Style="{StaticResource PclTextButton}"
                            IsEnabled="False" Click="BtnOpenFolder_Click" />
                    <Button x:Name="BtnLaunch" Margin="16,0,0,0" Content="{loc:Text Main.LaunchPcl}"
                            Style="{StaticResource PclTextButton}" Visibility="Collapsed"
                            Click="BtnLaunch_Click" />
                </StackPanel>
            </StackPanel>
        </HeaderedContentControl>

        <HeaderedContentControl Margin="0,15,0,0" Header="{loc:Text Main.Patches}" Style="{StaticResource PclCard}">
            <StackPanel>
                <TextBlock Margin="0,0,0,5" FontSize="12" Foreground="{DynamicResource BrushGray4}"
                           TextWrapping="Wrap" Text="{loc:Text Main.SelectRepairsHelp}" />
                <ItemsControl x:Name="ListPatches" Focusable="False"
                              ItemTemplate="{StaticResource PatchRowTemplate}" />
            </StackPanel>
        </HeaderedContentControl>

        <Grid Margin="0,18,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="BtnRestore" Content="{loc:Text Main.Restore}" Style="{StaticResource PclButton}"
                        IsEnabled="False" ToolTip="{loc:Text Main.RestoreTooltip}" Click="BtnRestore_Click" />
                <Button x:Name="BtnFix" Margin="12,0,0,0" MinWidth="140" Content="{loc:Text Main.Fix}" FontWeight="Bold"
                        Style="{StaticResource PclButtonHighlight}" IsEnabled="False" Click="BtnFix_Click" />
            </StackPanel>
        </Grid>

    </StackPanel>
</UserControl>
